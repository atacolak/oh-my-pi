#!/bin/sh
# Non-invasive dev launcher for the experimental app-viewport TUI (`--alt`).
#
# Delegate to the canonical repo-local `scripts/omp` launcher so bun/preload,
# symlink resolution, timing, and Herdr behavior cannot drift. Override its
# default launch directory with a temporary bunfig-free directory: trying the
# experiment must not create or modify the user's normal ~/.omp state.
set -e

# Resolve this script's real location even when invoked through a symlink.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)

if [ -z "${OMP_DEV_LAUNCH_DIR:-}" ]; then
	OMP_DEV_LAUNCH_DIR=${OMPALT_DEV_LAUNCH_DIR:-${TMPDIR:-/tmp}/ompalt-dev-cwd-$(id -u)}
	export OMP_DEV_LAUNCH_DIR
fi

exec "$scripts_dir/omp" --alt "$@"
