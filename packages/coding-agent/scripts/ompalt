#!/bin/sh
# Daily launcher for the app-viewport TUI (`--alt`).
#
# Delegate to the canonical repo-local `scripts/omp` launcher so bun/preload,
# symlink resolution, timing, and Herdr behavior cannot drift. Deliberately
# preserve HOME, XDG paths, profile selectors, sessions, and provider settings:
# this is normal OMP with the alternate renderer, not an isolated test install.
set -e

# Resolve this script's real location even when invoked through a symlink.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)

exec "$scripts_dir/omp" --alt "$@"
